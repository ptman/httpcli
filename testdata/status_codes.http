# HTTP status code tests.
# Tests: various status codes with assertions.

@host = {{HTTPBIN_BASE_URL}}

###
# @name ok200
GET {{host}}/status/200
Accept: application/json

?? status == 200
?? status >= 200
?? status < 300

###
# @name created201
GET {{host}}/status/201
Accept: application/json

?? status == 201
?? status >= 201
?? status < 300

###
# @name noContent204
GET {{host}}/status/204
Accept: application/json

?? status == 204
?? status >= 200
?? status < 300

###
# @name badRequest400
GET {{host}}/status/400
Accept: application/json

?? status == 400
?? status >= 400
?? status < 500

###
# @name notFound404
GET {{host}}/status/404
Accept: application/json

?? status == 404
?? status >= 400
?? status < 500

###
# @name serverError500
GET {{host}}/status/500
Accept: application/json

?? status == 500
?? status >= 500
?? status < 600
