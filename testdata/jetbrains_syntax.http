# Tests: # @name=value, # @ref=value.

@host = {{HTTPBIN_BASE_URL}}
@path = /get

###
# @name=jetbrainsName
GET {{host}}{{path}}?syntax=jetbrains
Accept: application/json

?? status == 200
?? body method == GET

###
