# String operation tests.
# Tests: startsWith, endsWith, includes, contains, matches.

@host = {{HTTPBIN_BASE_URL}}
@path = /get

###
# @name startsWith
GET {{host}}{{path}}?query=hello%20world
Accept: application/json

?? status == 200
?? body url includes query=hello
?? body url includes world

###
# @name endsWith
GET {{host}}{{path}}?query=hello%20world
Accept: application/json

?? status == 200
?? body url includes query=hello%20world
